{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "semanticCommits": "disabled",
  "commitMessagePrefix": "[renovate]",
  "timezone": "Europe/Berlin",
  "rebaseWhen": "behind-base-branch",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "on monday"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The sops version bundled into release packages",
      "managerFilePatterns": [
        "/^scripts/fetch-sops\\.sh$/"
      ],
      "matchStrings": [
        "SOPS_VERSION=\"(?<currentValue>[^\"]+)\" # renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Tool versions pinned in workflows, such as git-cliff",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.yml$/"
      ],
      "matchStrings": [
        "[A-Z_]+_VERSION: (?<currentValue>\\S+) # renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Minor and patch updates arrive as one grouped pull request as soon as Renovate finds them, and merge themselves once CI is green",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "description": "Tauri's crates and its CLI must move together",
      "matchPackageNames": [
        "/^tauri/",
        "/^@tauri-apps//"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "tauri"
    },
    {
      "description": "The bundled sops gets its own pull request; CI tests the app against it on every platform",
      "matchPackageNames": [
        "getsops/sops"
      ],
      "groupName": null,
      "commitMessageTopic": "bundled sops",
      "labels": [
        "sops"
      ],
      "automerge": true
    }
  ]
}
